<%- include('partials/header') %>

<section>
  <h2><%= contact ? 'Edit Contact' : 'Create Contact' %></h2>

  <form method="post" action="<%= formAction %>">
    <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
    <label for="first_name">First Name</label>
    <input id="first_name" name="first_name" type="text" value="<%= contact ? contact.firstName : '' %>" required>

    <label for="last_name">Last Name</label>
    <input id="last_name" name="last_name" type="text" value="<%= contact ? contact.lastName : '' %>" required>

    <label for="title">Title</label>
    <input id="title" name="title" type="text" value="<%= contact ? contact.title : '' %>">

    <label for="email">Email</label>
    <input id="email" name="email" type="email" value="<%= contact ? contact.email : '' %>">

    <label for="phone">Phone</label>
    <input id="phone" name="phone" type="text" value="<%= contact ? contact.phone : '' %>">

    <label for="organization_id">Organization</label>
    <select id="organization_id" name="organization_id" required>
      <% organizations.forEach(function (organization) { %>
      <option value="<%= organization.id %>" <% if (contact && contact.organizationId === organization.id) { %>selected<% } %>><%= organization.name %></option>
      <% }); %>
    </select>

    <button type="submit">Save</button>
  </form>

  <% if (contact) { %>
  <form method="post" action="/contacts/<%= contact.id %>/delete" onsubmit="return confirm('Delete this contact? This cannot be undone.');">
    <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
    <button type="submit">Delete Contact</button>
  </form>
  <% } %>
</section>

<%- include('partials/footer') %>