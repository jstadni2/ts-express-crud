{% include 'partials/head' %}
<section>
  <h2>{% if system %}Edit System{% else %}Create System{% endif %}</h2>

  <form method="post" action="{{ form_action }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <label for="name">System Name</label>
    <input id="name" name="name" type="text" value="{{ system.name | default: '' }}" required>

    <label for="system_type">System Type</label>
    <input id="system_type" name="system_type" type="text" value="{{ system.system_type | default: '' }}" required>

    <label for="description">Description</label>
    <textarea id="description" name="description" rows="4">{{ system.description | default: '' }}</textarea>

    <label for="installation_date">Installation Date</label>
    <input id="installation_date" name="installation_date" type="date" value="{{ system.installation_date | default: '' }}" required>

    <label for="warranty_expiry_date">Warranty Expiry Date</label>
    <input id="warranty_expiry_date" name="warranty_expiry_date" type="date" value="{{ system.warranty_expiry_date | default: '' }}">

    <label for="installer_organization_id">Installer Organization (Optional)</label>
    <select id="installer_organization_id" name="installer_organization_id">
      <option value="">-- Optional --</option>
      {% for organization in organizations %}
      <option value="{{ organization.id }}" {% if system and system.installer_organization_id == organization.id %}selected{% endif %}>{{ organization.name }}</option>
      {% endfor %}
    </select>

    <label for="equipment_condition">Equipment Condition</label>
    <input id="equipment_condition" name="equipment_condition" type="text" value="{{ system.equipment_condition | default: '' }}" placeholder="e.g., New, Good, Fair, Poor">

    <label for="status">Status</label>
    <select id="status" name="status" required>
      {% for status in installation_statuses %}
      <option value="{{ status }}" {% if system and system.status == status %}selected{% endif %}>{{ status }}</option>
      {% endfor %}
    </select>

    <label for="site_id">Site</label>
    <select id="site_id" name="site_id" required>
      {% for site in sites %}
      <option value="{{ site.id }}" {% if system and system.site_id == site.id %}selected{% endif %}>{{ site.site_name }} ({{ site.building_code }})</option>
      {% endfor %}
    </select>

    <label for="responsible_organization_id">Responsible Organization</label>
    <select id="responsible_organization_id" name="responsible_organization_id">
      <option value="">-- Optional --</option>
      {% for organization in organizations %}
      <option value="{{ organization.id }}" {% if system and system.responsible_organization_id == organization.id %}selected{% endif %}>{{ organization.name }}</option>
      {% endfor %}
    </select>

    <label for="contact_ids">System Contacts (multi-select)</label>
    <select id="contact_ids" name="contact_ids" multiple size="6">
      {% for contact in contacts %}
      <option value="{{ contact.id }}" {% if system and system.contact_ids contains contact.id %}selected{% endif %}>{{ contact.full_name }} ({{ contact.org_name }})</option>
      {% endfor %}
    </select>

    <button type="submit">Save</button>
  </form>

  {% if system %}
  <form method="post" action="/systems/{{ system.id }}/delete" onsubmit="return confirm('Delete this system? This cannot be undone.');">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <button type="submit">Delete System</button>
  </form>
  {% endif %}
</section>
{% include 'partials/footer' %}
