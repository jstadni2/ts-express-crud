{% include 'partials/head' %}
<section>
  <h2>{% if contact %}Edit Contact{% else %}Create Contact{% endif %}</h2>

  <form method="post" action="{{ form_action }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <label for="first_name">First Name</label>
    <input id="first_name" name="first_name" type="text" value="{{ contact.first_name | default: '' }}" required>

    <label for="last_name">Last Name</label>
    <input id="last_name" name="last_name" type="text" value="{{ contact.last_name | default: '' }}" required>

    <label for="title">Title</label>
    <input id="title" name="title" type="text" value="{{ contact.title | default: '' }}">

    <label for="email">Email</label>
    <input id="email" name="email" type="email" value="{{ contact.email | default: '' }}">

    <label for="phone">Phone</label>
    <input id="phone" name="phone" type="text" value="{{ contact.phone | default: '' }}">

    <label for="organization_id">Organization</label>
    <select id="organization_id" name="organization_id" required>
      {% for organization in organizations %}
      <option value="{{ organization.id }}" {% if contact and contact.organization_id == organization.id %}selected{% endif %}>{{ organization.name }}</option>
      {% endfor %}
    </select>

    <button type="submit">Save</button>
  </form>

  {% if contact %}
  <form method="post" action="/contacts/{{ contact.id }}/delete" onsubmit="return confirm('Delete this contact? This cannot be undone.');">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <button type="submit">Delete Contact</button>
  </form>
  {% endif %}
</section>
{% include 'partials/footer' %}
