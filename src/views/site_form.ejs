<%- include('partials/header') %>

<section>
  <h2><%= site ? 'Edit Site' : 'Create Site' %></h2>

  <form method="post" action="<%= formAction %>">
    <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
    <label for="site_name">Site Name</label>
    <input id="site_name" name="site_name" type="text" value="<%= site ? site.siteName : '' %>" required>

    <label for="address_line1">Address Line 1</label>
    <input id="address_line1" name="address_line1" type="text" value="<%= site ? site.addressLine1 : '' %>" required>

    <label for="address_line2">Address Line 2</label>
    <input id="address_line2" name="address_line2" type="text" value="<%= site && site.addressLine2 ? site.addressLine2 : '' %>">

    <label for="city">City</label>
    <input id="city" name="city" type="text" value="<%= site ? site.city : '' %>" required>

    <label for="state">State</label>
    <input id="state" name="state" type="text" value="<%= site ? site.state : '' %>" required>

    <label for="postal_code">Postal Code</label>
    <input id="postal_code" name="postal_code" type="text" value="<%= site ? site.postalCode : '' %>" required>

    <label for="country">Country</label>
    <input id="country" name="country" type="text" value="<%= site ? site.country : '' %>" required>

    <label for="building_code">Building Code</label>
    <input id="building_code" name="building_code" type="text" value="<%= site ? site.buildingCode : '' %>" required>

    <label for="ownership">Ownership</label>
    <select id="ownership" name="ownership" required>
      <% ownershipOptions.forEach(function (option) { %>
      <option value="<%= option %>" <% if (site && site.ownership === option) { %>selected<% } %>><%= option %></option>
      <% }); %>
    </select>

    <label for="status">Status</label>
    <select id="status" name="status" required>
      <% statusOptions.forEach(function (option) { %>
      <option value="<%= option %>" <% if (site && site.status === option) { %>selected<% } %>><%= option %></option>
      <% }); %>
    </select>

    <label for="description">Description</label>
    <textarea id="description" name="description" rows="4"><%= site ? site.description : '' %></textarea>

    <label for="longitude">Longitude</label>
    <input id="longitude" name="longitude" type="text" value="<%= site && site.longitude != null ? site.longitude : '' %>">

    <label for="latitude">Latitude</label>
    <input id="latitude" name="latitude" type="text" value="<%= site && site.latitude != null ? site.latitude : '' %>">

    <label for="room_number">Room Number(s)</label>
    <input id="room_number" name="room_number" type="text" value="<%= site && site.roomNumber ? site.roomNumber : '' %>">

    <label for="owner_organization_id">Owner Organization</label>
    <select id="owner_organization_id" name="owner_organization_id" required>
      <% organizations.forEach(function (organization) { %>
      <option value="<%= organization.id %>" <% if (site && site.ownerOrganizationId === organization.id) { %>selected<% } %>><%= organization.name %></option>
      <% }); %>
    </select>

    <label for="contact_ids">Site Contacts (multi-select)</label>
    <select id="contact_ids" name="contact_ids" multiple size="6">
      <% contacts.forEach(function (contact) { %>
      <%
      const fullName = contact.firstName + ' ' + contact.lastName;
      const contactIds = site && site.contacts ? site.contacts.map(function (c) { return c.id; }) : [];
      %>
      <option value="<%= contact.id %>" <% if (contactIds.includes(contact.id)) { %>selected<% } %>><%= fullName %> (<%= contact.organization ? contact.organization.name : '' %>)</option>
      <% }); %>
    </select>

    <button type="submit">Save</button>
  </form>

  <% if (site) { %>
  <form method="post" action="/sites/<%= site.id %>/delete" onsubmit="return confirm('Delete this site? This cannot be undone.');">
    <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
    <button type="submit">Delete Site</button>
  </form>
  <% } %>
</section>

<%- include('partials/footer') %>