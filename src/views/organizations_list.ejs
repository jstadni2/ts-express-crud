<%- include('partials/header') %>

<section>
  <h2>Organizations</h2>
  <% if (current_role && current_role !== 'viewer') { %>
  <p><a href="/organizations/new">Create New Organization</a></p>
  <% } %>

  <%
  const columns = [
    { label: 'Name', key: 'name', sort_type: 'text' },
    { label: 'Type', key: 'type', sort_type: 'text' },
    { label: 'Description', key: 'description', sort_type: 'text' },
    { label: 'Action', key: 'action', sortable: false, filterable: false }
  ];

  let bodyHtml = '';
  organizations.forEach(function (organization, index) {
    const isViewer = current_role === 'viewer';
    const actionHref = isViewer ? ('/organizations/' + organization.id + '/detail') : ('/organizations/' + organization.id + '/edit');
    const actionLabel = isViewer ? 'View' : 'Edit';
    bodyHtml += '<tr data-rfd-row data-testid="row-' + (index + 1) + '">';
    bodyHtml += '<td data-testid="row-' + (index + 1) + '-name">' + organization.name + '</td>';
    bodyHtml += '<td data-testid="row-' + (index + 1) + '-type">' + organization.orgType + '</td>';
    bodyHtml += '<td data-testid="row-' + (index + 1) + '-description">' + (organization.description || '') + '</td>';
    bodyHtml += '<td data-testid="row-' + (index + 1) + '-action">';
    bodyHtml += '<a href="' + actionHref + '">' + actionLabel + '</a>';
    bodyHtml += '</td>';
    bodyHtml += '</tr>';
  });
  if (organizations.length === 0) {
    bodyHtml += '<tr data-rfd-empty-row><td colspan="4">No organizations recorded yet.</td></tr>';
  }
  %>
  <%- include('partials/table', { tableId: 'organizations-table', caption: 'Organizations list', columns: columns, bodyHtml: bodyHtml }) %>
</section>

<%- include('partials/footer') %>