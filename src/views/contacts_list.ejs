<%- include('partials/header') %>

<section>
  <h2>Contacts</h2>
  <% if (current_role && current_role !== 'viewer') { %>
  <p><a href="/contacts/new">Create New Contact</a></p>
  <% } %>

  <%
  const columns = [
    { label: 'Name', key: 'name', sort_type: 'text' },
    { label: 'Title', key: 'title', sort_type: 'text' },
    { label: 'Email', key: 'email', sort_type: 'text' },
    { label: 'Phone', key: 'phone', sort_type: 'text' },
    { label: 'Organization', key: 'organization', sort_type: 'text' },
    { label: 'Action', key: 'action', sortable: false, filterable: false }
  ];

  let bodyHtml = '';
  contacts.forEach(function (contact, index) {
    const isViewer = current_role === 'viewer';
    const actionHref = isViewer ? ('/contacts/' + contact.id + '/detail') : ('/contacts/' + contact.id + '/edit');
    const actionLabel = isViewer ? 'View' : 'Edit';
    const fullName = contact.firstName + ' ' + contact.lastName;
    bodyHtml += '<tr data-rfd-row data-testid="row-' + (index + 1) + '">';
    bodyHtml += '<td data-sort-value="' + fullName + '" data-testid="row-' + (index + 1) + '-name">' + fullName + '</td>';
    bodyHtml += '<td data-testid="row-' + (index + 1) + '-title">' + (contact.title || '') + '</td>';
    bodyHtml += '<td data-testid="row-' + (index + 1) + '-email">' + (contact.email || '') + '</td>';
    bodyHtml += '<td data-testid="row-' + (index + 1) + '-phone">' + (contact.phone || '') + '</td>';
    bodyHtml += '<td data-testid="row-' + (index + 1) + '-organization">' + (contact.organization ? contact.organization.name : '') + '</td>';
    bodyHtml += '<td data-testid="row-' + (index + 1) + '-action">';
    bodyHtml += '<a href="' + actionHref + '">' + actionLabel + '</a>';
    bodyHtml += '</td>';
    bodyHtml += '</tr>';
  });
  if (contacts.length === 0) {
    bodyHtml += '<tr data-rfd-empty-row><td colspan="6">No contacts recorded yet.</td></tr>';
  }
  %>
  <%- include('partials/table', { tableId: 'contacts-table', caption: 'Contacts list', columns: columns, bodyHtml: bodyHtml }) %>
</section>

<%- include('partials/footer') %>