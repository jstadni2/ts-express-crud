<%- include('partials/header') %>

<section>
  <h2>Sites</h2>
  <% if (current_role && current_role !== 'viewer') { %>
  <p><a href="/sites/new">Create New Site</a></p>
  <% } %>

  <%
  const columns = [
    { label: 'Site Name', key: 'site_name', sort_type: 'text' },
    { label: 'Building Code', key: 'building_code', sort_type: 'text' },
    { label: 'Ownership', key: 'ownership', sort_type: 'text' },
    { label: 'Status', key: 'status', sort_type: 'text' },
    { label: 'Owner Organization', key: 'owner_org', sort_type: 'text' },
    { label: 'Room Number(s)', key: 'room_number', sort_type: 'text' },
    { label: 'Action', key: 'action', sortable: false, filterable: false }
  ];

  let bodyHtml = '';
  sites.forEach(function (site, index) {
    const isViewer = current_role === 'viewer';
    const actionHref = isViewer ? ('/sites/' + site.id + '/detail') : ('/sites/' + site.id + '/edit');
    const actionLabel = isViewer ? 'View' : 'Edit';
    bodyHtml += '<tr data-rfd-row data-testid="row-' + (index + 1) + '">';
    bodyHtml += '<td data-testid="row-' + (index + 1) + '-site-name">' + site.siteName + '</td>';
    bodyHtml += '<td data-testid="row-' + (index + 1) + '-building-code">' + site.buildingCode + '</td>';
    bodyHtml += '<td data-testid="row-' + (index + 1) + '-ownership">' + site.ownership + '</td>';
    bodyHtml += '<td data-testid="row-' + (index + 1) + '-status">' + site.status + '</td>';
    bodyHtml += '<td data-testid="row-' + (index + 1) + '-owner-organization">' + (site.ownerOrganization ? site.ownerOrganization.name : '') + '</td>';
    bodyHtml += '<td data-testid="row-' + (index + 1) + '-room-number">' + (site.roomNumber || 'N/A') + '</td>';
    bodyHtml += '<td data-testid="row-' + (index + 1) + '-action">';
    bodyHtml += '<a href="' + actionHref + '">' + actionLabel + '</a>';
    bodyHtml += '</td>';
    bodyHtml += '</tr>';
  });
  if (sites.length === 0) {
    bodyHtml += '<tr data-rfd-empty-row><td colspan="7">No sites recorded yet.</td></tr>';
  }
  %>
  <%- include('partials/table', { tableId: 'sites-table', caption: 'Sites list', columns: columns, bodyHtml: bodyHtml }) %>
</section>

<%- include('partials/footer') %>