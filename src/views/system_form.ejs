<%- include('partials/header') %>

<section>
  <h2><%= system ? 'Edit System' : 'Create System' %></h2>

  <form method="post" action="<%= formAction %>">
    <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
    <label for="name">System Name</label>
    <input id="name" name="name" type="text" value="<%= system ? system.name : '' %>" required>

    <label for="system_type">System Type</label>
    <input id="system_type" name="system_type" type="text" value="<%= system ? system.systemType : '' %>" required>

    <label for="description">Description</label>
    <textarea id="description" name="description" rows="4"><%= system ? system.description : '' %></textarea>

    <label for="installation_date">Installation Date</label>
    <input id="installation_date" name="installation_date" type="date" value="<%= system ? system.installationDate : '' %>" required>

    <label for="warranty_expiry_date">Warranty Expiry Date</label>
    <input id="warranty_expiry_date" name="warranty_expiry_date" type="date" value="<%= system && system.warrantyExpiryDate ? system.warrantyExpiryDate : '' %>">

    <label for="installer_organization_id">Installer Organization (Optional)</label>
    <select id="installer_organization_id" name="installer_organization_id">
      <option value="">-- Optional --</option>
      <% organizations.forEach(function (organization) { %>
      <option value="<%= organization.id %>" <% if (system && system.installerOrganizationId === organization.id) { %>selected<% } %>><%= organization.name %></option>
      <% }); %>
    </select>

    <label for="equipment_condition">Equipment Condition</label>
    <input id="equipment_condition" name="equipment_condition" type="text" value="<%= system ? system.equipmentCondition : '' %>" placeholder="e.g., New, Good, Fair, Poor">

    <label for="status">Status</label>
    <select id="status" name="status" required>
      <% installationStatuses.forEach(function (status) { %>
      <option value="<%= status %>" <% if (system && system.status === status) { %>selected<% } %>><%= status %></option>
      <% }); %>
    </select>

    <label for="site_id">Site</label>
    <select id="site_id" name="site_id" required>
      <% sites.forEach(function (site) { %>
      <option value="<%= site.id %>" <% if (system && system.siteId === site.id) { %>selected<% } %>><%= site.siteName %> (<%= site.buildingCode %>)</option>
      <% }); %>
    </select>

    <label for="responsible_organization_id">Responsible Organization</label>
    <select id="responsible_organization_id" name="responsible_organization_id">
      <option value="">-- Optional --</option>
      <% organizations.forEach(function (organization) { %>
      <option value="<%= organization.id %>" <% if (system && system.responsibleOrganizationId === organization.id) { %>selected<% } %>><%= organization.name %></option>
      <% }); %>
    </select>

    <label for="contact_ids">System Contacts (multi-select)</label>
    <select id="contact_ids" name="contact_ids" multiple size="6">
      <% contacts.forEach(function (contact) { %>
      <%
      const fullName = contact.firstName + ' ' + contact.lastName;
      const contactIds = system && system.contacts ? system.contacts.map(function (c) { return c.id; }) : [];
      %>
      <option value="<%= contact.id %>" <% if (contactIds.includes(contact.id)) { %>selected<% } %>><%= fullName %> (<%= contact.organization ? contact.organization.name : '' %>)</option>
      <% }); %>
    </select>

    <button type="submit">Save</button>
  </form>

  <% if (system) { %>
  <form method="post" action="/systems/<%= system.id %>/delete" onsubmit="return confirm('Delete this system? This cannot be undone.');">
    <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
    <button type="submit">Delete System</button>
  </form>
  <% } %>
</section>

<%- include('partials/footer') %>