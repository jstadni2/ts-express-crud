<div class="rfd-table-container" data-rfd-table-container>
  <table id="<%= tableId %>" class="rfd-table" data-rfd-enhanced-table data-testid="<%= tableId %>">
    <caption><%= caption %></caption>
    <thead>
      <tr>
        <% columns.forEach(function (column, idx) { %>
        <% const sortable = column.sortable !== false; %>
        <% const filterable = column.filterable !== false; %>
        <% const colKey = column.key || 'col_' + idx; %>
        <th scope="col"
            data-column-key="<%= colKey %>"
            data-sort-type="<%= column.sort_type || 'text' %>"
            data-testid="column-<%= colKey %>"
            <% if (sortable) { %>data-sortable="true" aria-sort="none"<% } %>
            <% if (filterable) { %>data-filterable="true"<% } %>>
          <div class="rfd-th-content">
            <span class="rfd-th-label"><%= column.label %></span>
            <span class="rfd-th-controls">
              <% if (sortable) { %>
              <button type="button"
                      class="ilw-button ilw-button-small rfd-icon-button rfd-control-button"
                      data-rfd-sort-button
                      data-testid="sort-button-<%= colKey %>"
                      aria-label="Sort <%= column.label %>">
                <ilw-icon icon="more" aria-hidden="true"></ilw-icon>
                <span class="ilw-sr-only" data-rfd-sort-text>Sort <%= column.label %> not applied</span>
                <span class="rfd-sort-indicator" data-rfd-sort-indicator aria-hidden="true">&lt;&gt;</span>
              </button>
              <% } %>
              <% if (filterable) { %>
              <button type="button"
                      class="ilw-button ilw-button-small rfd-icon-button rfd-control-button"
                      data-rfd-filter-toggle
                      data-testid="filter-toggle-<%= colKey %>"
                      data-column-index="<%= idx %>"
                      aria-expanded="false"
                      aria-controls="<%= tableId %>_filter_cell_<%= idx %>"
                      aria-label="Filter <%= column.label %>">
                <ilw-icon icon="search" aria-hidden="true"></ilw-icon>
                <span class="ilw-sr-only">Toggle filter for <%= column.label %></span>
              </button>
              <% } %>
            </span>
          </div>
        </th>
        <% }); %>
      </tr>
      <tr class="rfd-filter-row" data-rfd-filter-row hidden>
        <% columns.forEach(function (column, idx) { %>
        <% const filterable = column.filterable !== false; %>
        <% const colKey = column.key || 'col_' + idx; %>
        <th scope="col" class="rfd-filter-cell<% if (!filterable) { %> rfd-filter-cell-empty<% } %>">
          <% if (filterable) { %>
          <div id="<%= tableId %>_filter_cell_<%= idx %>"
               class="rfd-filter-cell-content"
               data-rfd-filter-cell
               data-testid="filter-cell-<%= colKey %>"
               hidden>
            <label for="<%= tableId %>_filter_input_<%= idx %>">Filter <%= column.label %></label>
            <input id="<%= tableId %>_filter_input_<%= idx %>"
                   data-rfd-filter-input
                   data-testid="filter-row-<%= colKey %>"
                   data-column-index="<%= idx %>"
                   type="text"
                   autocomplete="off">
          </div>
          <% } %>
        </th>
        <% }); %>
      </tr>
    </thead>
    <tbody>
      <%- bodyHtml %>
      <tr data-rfd-no-match-row hidden>
        <td colspan="<%= columns.length %>">No matching records found.</td>
      </tr>
    </tbody>
  </table>
  <p class="ilw-sr-only" data-rfd-status aria-live="polite"></p>
</div>