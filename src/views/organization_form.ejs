<%- include('partials/header') %>

<section>
  <h2><%= organization ? 'Edit Organization' : 'Create Organization' %></h2>

  <form method="post" action="<%= formAction %>">
    <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
    <label for="name">Name</label>
    <input id="name" name="name" type="text" value="<%= organization ? organization.name : '' %>" required>

    <label for="org_type">Organization Type</label>
    <select id="org_type" name="org_type" required>
      <% orgTypeOptions.forEach(function (option) { %>
      <option value="<%= option %>" <% if (organization && organization.orgType === option) { %>selected<% } %>><%= option %></option>
      <% }); %>
    </select>

    <label for="description">Description</label>
    <textarea id="description" name="description" rows="4"><%= organization ? organization.description : '' %></textarea>

    <button type="submit">Save</button>
  </form>

  <% if (organization) { %>
  <form method="post" action="/organizations/<%= organization.id %>/delete" onsubmit="return confirm('Delete this organization? This cannot be undone.');">
    <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
    <button type="submit">Delete Organization</button>
  </form>
  <% } %>
</section>

<%- include('partials/footer') %>