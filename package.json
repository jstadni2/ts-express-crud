{
  "name": "avdb-ts-express",
  "version": "1.0.0",
  "description": "AV Installation Database (AVDB) — TypeScript + Express.js port of the Flask CRUD app",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/src/bootstrap.js",
    "dev": "node dist/dev/app_dev.js",
    "init-db": "node dist/src/init_db.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-session": "^1.18.1",
    "liquidjs": "10.30.1",
    "openid-client": "6.9.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "7.0.2"
  }
}
