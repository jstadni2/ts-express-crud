{
  "name": "avdb-ts-express",
  "version": "1.0.0",
  "description": "AV Installation Database (AVDB) ported to TypeScript + Express.js + Drizzle ORM",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "mkdir -p dist/src/views dist/src/static && cp -r src/views/* dist/src/views/ && cp -r src/static/* dist/src/static/",
    "start": "node dist/src/bootstrap.js",
    "dev": "node dist/dev/app_dev.js",
    "init-db": "node dist/src/init_db.js",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "drizzle-orm": "0.45.4",
    "ejs": "^3.1.10",
    "express": "5.3.0",
    "express-session": "^1.18.1",
    "openid-client": "^6.3.4",
    "pg": "8.23.1",
    "pg-format": "^1.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/pg-format": "^1.0.5",
    "tsx": "^4.19.0",
    "typescript": "7.0.2"
  }
}
